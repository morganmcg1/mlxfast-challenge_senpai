+private struct LagunaColdDuplicateArm {
+    let label: String
+    let mode: String
+    let duplicateCount: Int
+}
+
+private struct LagunaColdDuplicateMeasurement {
+    let arm: LagunaColdDuplicateArm
+    let step: Int
+}
