# R93-B dispatch-ladder glue knob (research instrument, NOT a shipping change)
#
# Injects K = depth * 40 extra bit-exact `maximum(h, h)` dispatches into the
# single-token decode layer loop of LagunaRuntimeModel.swift, so an external
# driver can measure the marginal end-to-end wall cost of one MLX dispatch.
#
# Controls (single-token decode only; prefill and 512-seed paths untouched):
#   DARKBLOOM_R93_GLUE_MAP            path to a 4-byte file that is mmap'd once
#                                     at first use. Its little-endian Int32 is
#                                     read live on every decode step and used as
#                                     the per-layer glue depth. This is the
#                                     control channel used by the R93-B rig:
#                                     the driver rewrites the word between
#                                     steps, so K can change WITHIN one process
#                                     with no relaunch and no rebuild.
#   DARKBLOOM_R93_MAX_GLUE_PER_LAYER  static fallback depth, used only when
#                                     DARKBLOOM_R93_GLUE_MAP is unset. Default 0,
#                                     which is byte-for-byte the shipped path.
#
# depth d adds d dispatches per layer; the model has 40 layers, so K = 40*d.
# The rig drives d in {0, 1, 3, 6} -> K in {0, 40, 120, 240}.
#
# Rule 45: `maximum(h, h)` is an ADDITION only. Every R93-B session emitted a
# single token-stream hash across all K slots with zero teacher-forced
# mismatches, so the injected work cannot change any checked token.
# Rule 46 caveat: `maximum(h, h)` blocks MLX buffer donation, so the recovered
# per-dispatch cost is an UPPER bracket on a real fused dispatch, not a floor.
#
# Result: the M4 end-to-end wall ladder is a HINGE, not a line. See
# research/fern-r93-stage3-preregistration.md and the PR #497 report.
#
# Base SHA: 17a4bad44635bb52cb6051a61338b9681ad739dd
# Re-apply:  git checkout 17a4bad44635bb52cb6051a61338b9681ad739dd -- Sources/MLXFastModel/LagunaRuntimeModel.swift \
#              && git apply research/fern-r93-maxglue-ladder.patch
#
# RELOCATION WARNING: the hunks are anchored on the single-token decode layer
# loop and on the private-helper block near the end of the file. If either
# region moves, re-derive the patch from a fresh edit rather than forcing the
# hunk offsets; a mis-anchored glue call outside `isSingleTokenDecode` would
# silently contaminate prefill timing.
diff --git a/Sources/MLXFastModel/LagunaRuntimeModel.swift b/Sources/MLXFastModel/LagunaRuntimeModel.swift
index fdaff41..cc37a21 100644
--- a/Sources/MLXFastModel/LagunaRuntimeModel.swift
+++ b/Sources/MLXFastModel/LagunaRuntimeModel.swift
@@ -8994,6 +8994,7 @@ final class LagunaRuntimeModelInner: Module {
             h: h, cache: cache?[slidingAttentionIdx], windowSize: slidingWindow)
 
         let isSingleTokenDecode = inputs.dims(1, 1)
+        let r93Glue = isSingleTokenDecode ? lagunaR93GlueDepth() : 0
 
         // One cos/sin table per attention family per decode step, shared by
         // every layer of that family (their caches advance in lockstep). Each
@@ -9038,6 +9039,11 @@ final class LagunaRuntimeModelInner: Module {
                 }
             }
             lagunaInjectLayerWork(layer: i, isSingleTokenDecode: isSingleTokenDecode)
+            if isSingleTokenDecode, r93Glue > 0 {
+                for _ in 0..<r93Glue {
+                    h = maximum(h, h)
+                }
+            }
