+import Foundation
+import MLX
+import MLXNN
+
+/// `DARKBLOOM_SCALE_CENSUS=1` (research-only, default OFF): one-shot init-time
+/// census of every uint8 E4M3 scale plane a decode dispatch can read, on the
+/// real shipped banks after `eval(fusedArrays)`. Per plane it reports element
+/// count, min, max, distinct-code count, the occupied code set, and the
+/// `max-min` span distribution at two granularities: the whole kernel row
+/// (all groups a decode output row consumes) and the 32-group block a
+/// simdgroup covers in one pass. `row_le15` is the fraction of rows a 4-bit
+/// per-row-base dictionary represents without an escape.
+let lagunaScaleCensusEnabled =
+    ProcessInfo.processInfo.environment["DARKBLOOM_SCALE_CENSUS"] == "1"
+
+final class LagunaScaleCensus {
+    private struct Acc {
+        var n = 0
+        var rows = 0
+        var blocks = 0
+        var rowLE = [Int](repeating: 0, count: 7)
+        var blkLE = [Int](repeating: 0, count: 7)
+        var hist = [Int](repeating: 0, count: 256)
+        var rowSpanMax = 0
+        var blkSpanMax = 0
+    }
+
+    private static let thresholds = [1, 3, 7, 15, 31, 63, 255]
+
+    private var families: [String: Acc] = [:]
+    private var order: [String] = []
+
+    func record(_ family: String, _ plane: String, _ scales: MLXArray?) {
+        guard lagunaScaleCensusEnabled, let scales else { return }
+        guard scales.dtype == .uint8, scales.ndim >= 2 else {
+            write("plane \(plane) skipped dtype=\(scales.dtype) shape=\(scales.shape)")
+            return
+        }
+        let groups = scales.dim(scales.ndim - 1)
+        let rowsPlane = contiguous(scales).reshaped([-1, groups])
+        var acc = Acc()
+        measure(rowsPlane, into: &acc, blockSize: 32)
+        histogram(rowsPlane, into: &acc)
+        write("plane \(plane) shape=\(scales.shape) " + line(acc))
+        if families[family] == nil {
+            families[family] = Acc()
+            order.append(family)
+        }
+        merge(acc, into: &families[family]!)
+    }
+
+    func report() {
+        guard lagunaScaleCensusEnabled else { return }
+        var global = Acc()
+        for family in order {
+            let acc = families[family]!
+            merge(acc, into: &global)
+            write("family \(family) " + line(acc))
+        }
+        write("global " + line(global))
+    }
+
+    private func measure(_ p: MLXArray, into acc: inout Acc, blockSize: Int) {
+        let groups = p.dim(1)
+        acc.n = p.size
+        acc.rows = p.dim(0)
+        let rowMin = p.min(axis: 1).asType(.int32)
+        let rowMax = p.max(axis: 1).asType(.int32)
+        let rowSpan = rowMax - rowMin
+        acc.rowSpanMax = Int(rowSpan.max().item(Int32.self))
+        for (i, t) in Self.thresholds.enumerated() {
+            acc.rowLE[i] = Int((rowSpan .<= Int32(t)).asType(.int32).sum().item(Int32.self))
+        }
+        guard groups.isMultiple(of: blockSize) else {
+            acc.blocks = acc.rows
+            acc.blkLE = acc.rowLE
+            acc.blkSpanMax = acc.rowSpanMax
+            return
+        }
+        let blocks = p.reshaped([-1, blockSize])
+        acc.blocks = blocks.dim(0)
+        let blkSpan = blocks.max(axis: 1).asType(.int32) - blocks.min(axis: 1).asType(.int32)
+        acc.blkSpanMax = Int(blkSpan.max().item(Int32.self))
+        for (i, t) in Self.thresholds.enumerated() {
+            acc.blkLE[i] = Int((blkSpan .<= Int32(t)).asType(.int32).sum().item(Int32.self))
+        }
+    }
+
+    private func histogram(_ p: MLXArray, into acc: inout Acc) {
+        let lo = Int(p.min().item(UInt8.self))
+        let hi = Int(p.max().item(UInt8.self))
+        for code in lo...hi {
+            let count = Int((p .== UInt8(code)).asType(.int32).sum().item(Int32.self))
+            if count > 0 { acc.hist[code] = count }
+        }
+    }
+
+    private func merge(_ src: Acc, into dst: inout Acc) {
+        dst.n += src.n
+        dst.rows += src.rows
+        dst.blocks += src.blocks
+        for i in 0..<dst.rowLE.count { dst.rowLE[i] += src.rowLE[i] }
+        for i in 0..<dst.blkLE.count { dst.blkLE[i] += src.blkLE[i] }
+        for code in 0..<256 { dst.hist[code] += src.hist[code] }
+        dst.rowSpanMax = max(dst.rowSpanMax, src.rowSpanMax)
+        dst.blkSpanMax = max(dst.blkSpanMax, src.blkSpanMax)
+    }
+
+    private func line(_ acc: Acc) -> String {
+        let present = (0..<256).filter { acc.hist[$0] > 0 }
+        var text = "n=\(acc.n) min=\(present.first ?? -1) max=\(present.last ?? -1)"
+        text += " distinct=\(present.count)"
+        text += " codes=[\(present.map(String.init).joined(separator: ","))]"
+        text += " rows=\(acc.rows) row_span_max=\(acc.rowSpanMax)"
+        text += " row_le=[" + fractions(acc.rowLE, acc.rows) + "]"
+        text += " blocks=\(acc.blocks) blk_span_max=\(acc.blkSpanMax)"
+        text += " blk_le=[" + fractions(acc.blkLE, acc.blocks) + "]"
+        text += " hist=[" + present.map { "\($0):\(acc.hist[$0])" }.joined(separator: ",") + "]"
+        return text
+    }
+
+    private func fractions(_ counts: [Int], _ total: Int) -> String {
+        guard total > 0 else { return "" }
+        return zip(Self.thresholds, counts).map {
+            String(format: "le%d:%.6f", $0.0, Double($0.1) / Double(total))
+        }.joined(separator: ",")
+    }
+
+    private func write(_ text: String) {
+        FileHandle.standardError.write(Data("mlxfast: scale-census \(text)\n".utf8))
+    }
+}
+
+extension LagunaRuntimeModel {
+    /// Walks every uint8 scale plane the decode path can read and prints the
+    /// census. Called from `prepareFusedRuntimeWeights()` under the env gate.
+    func lagunaRunScaleCensus() {
+        guard lagunaScaleCensusEnabled else { return }
+        let census = LagunaScaleCensus()
+        for layer in model.layers {
+            let attn = layer.selfAttn
+            let idx = attn.layerIdx
+            if let bank = attn._nativeAffineQKV, bank.scales.dtype == .uint8 {
+                let qRows = attn.nHeads * attn.headDim
+                let kvRows = LagunaConstants.numKeyValueHeads * attn.headDim
+                census.record("attn.q", "L\(idx).q", bank.scales[0..<qRows])
+                census.record("attn.k", "L\(idx).k", bank.scales[qRows..<(qRows + kvRows)])
+                census.record(
+                    "attn.v", "L\(idx).v",
+                    bank.scales[(qRows + kvRows)..<(qRows + 2 * kvRows)])
+            } else {
+                census.record("attn.qkv", "L\(idx).qkv", attn._nativeAffineQKV?.scales)
+            }
+            census.record("attn.o", "L\(idx).o", attn._nativeAffineOProj?.scales)
+            guard let sparse = layer.mlp as? LagunaRuntimeSparseMoEBlock else { continue }
+            census.record(
+                "routed.gate_up", "L\(idx).routed.gate_up", sparse._fusedRoutedGateUpScales)
+            census.record("routed.down", "L\(idx).routed.down", sparse._routedDownScales)
+            census.record(
+                "routed.packed", "L\(idx).routed.packed", sparse._packedRoutedGateUpBank)
+            census.record(
+                "shared.gate_up", "L\(idx).shared.gate_up",
+                sparse.sharedExpert._fusedGateUpScales)
+            census.record(
+                "shared.down", "L\(idx).shared.down",
+                (sparse.sharedExpert.downProj as? QuantizedLinear)?.scales)
+        }
+        census.report()
+    }
+}
