+// ---------------------------------------------------------------------------
+// Research-only barrier-SITE trace (maple-fern PR #268 r2). NEVER SUBMITTED.
+// device.cpp is outside editablePaths; this block exists only so a local
+// worker can dump, in encode order, every compute dispatch of a decode step
+// together with the command-buffer index, whether MLX inserted a
+// memoryBarrier in front of it, and which earlier dispatch produced the
+// resource that forced that barrier. r1 priced a barrier at 1.3003 us; this
+// says where the barriers actually are.
+//
+// Enable with DBTAX_SITE_TRACE=<path>. One line per dispatch:
+//   DBSITE ep=<epoch> cb=<n> ord=<n> bar=<0|1> gap=<n> raw=<ords> war=<ords>
+//          grid=<x>x<y>x<z> tg=<x>x<y>x<z> k=<kernel>
+// plus DBEPOCH at every CommandEncoder::synchronize() (one full host sync,
+// i.e. one worker decode step boundary) and DBCB at every commit().
+// ---------------------------------------------------------------------------
+namespace {
+class DbSiteTrace {
+ public:
+  static DbSiteTrace& instance() {
+    static DbSiteTrace t;
+    return t;
+  }
+
+  bool on() const {
+    return fh_ != nullptr;
+  }
+
+  void register_pso(const void* pso, const std::string& name) {
+    if (!fh_) {
+      return;
+    }
+    names_[pso] = name;
+  }
+
+  void note_raw(const void* buf) {
+    if (fh_) {
+      raw_.push_back(buf);
+    }
+  }
+  void note_war(const void* buf) {
+    if (fh_) {
+      war_.push_back(buf);
+    }
+  }
+  void note_output(const void* buf) {
+    if (fh_) {
+      pending_out_.push_back(buf);
+    }
+  }
+  void note_barrier() {
+    if (fh_) {
+      barrier_ = true;
+    }
+  }
+  void note_commit() {
+    if (fh_) {
+      fprintf(fh_, "DBCB ep=%llu cb=%llu ord=%llu\n", ep_, cb_, ord_);
+      cb_++;
+    }
+  }
+  void note_sync() {
+    if (fh_) {
+      fprintf(fh_, "DBEPOCH ep=%llu ord=%llu cb=%llu\n", ep_, ord_, cb_);
+      ep_++;
+      fflush(fh_);
+    }
+  }
+
+  void emit(const void* pso, MTL::Size grid, MTL::Size tg) {
+    if (!fh_) {
+      return;
+    }
+    auto it = names_.find(pso);
+    const char* kname = (it == names_.end()) ? "<unnamed>" : it->second.c_str();
+    fprintf(
+        fh_,
+        "DBSITE ep=%llu cb=%llu ord=%llu bar=%d gap=%llu raw=%s war=%s "
+        "grid=%llux%llux%llu tg=%llux%llux%llu k=%s\n",
+        ep_,
+        cb_,
+        ord_,
+        barrier_ ? 1 : 0,
+        gap_,
+        resolve(raw_).c_str(),
+        resolve(war_).c_str(),
+        (unsigned long long)grid.width,
+        (unsigned long long)grid.height,
+        (unsigned long long)grid.depth,
+        (unsigned long long)tg.width,
+        (unsigned long long)tg.height,
+        (unsigned long long)tg.depth,
+        kname);
+    // The producer map must only ever answer with STRICTLY earlier
+    // dispatches, so this dispatch's own outputs land after its record.
+    for (const void* b : pending_out_) {
+      producer_[b] = ord_;
+    }
+    gap_ = barrier_ ? 0 : gap_ + 1;
+    barrier_ = false;
+    raw_.clear();
+    war_.clear();
+    pending_out_.clear();
+    ord_++;
+  }
+
+ private:
+  DbSiteTrace() {
+    const char* p = std::getenv("DBTAX_SITE_TRACE");
+    if (p && *p) {
+      fh_ = fopen(p, "w");
+    }
+  }
+
+  std::string resolve(const std::vector<const void*>& bufs) {
+    std::vector<unsigned long long> ords;
+    for (const void* b : bufs) {
+      auto it = producer_.find(b);
+      unsigned long long o = (it == producer_.end())
+          ? (unsigned long long)-1
+          : (unsigned long long)it->second;
+      if (std::find(ords.begin(), ords.end(), o) == ords.end()) {
+        ords.push_back(o);
+      }
+    }
+    if (ords.empty()) {
+      return "-";
+    }
+    std::string s;
+    for (size_t i = 0; i < ords.size(); ++i) {
+      if (i) {
+        s += ",";
+      }
+      if (ords[i] == (unsigned long long)-1) {
+        s += "x";
+      } else {
+        s += std::to_string(ords[i]);
+      }
+    }
+    return s;
+  }
+
+  FILE* fh_{nullptr};
+  unsigned long long ord_{0}, cb_{0}, ep_{0}, gap_{0};
+  bool barrier_{false};
+  std::vector<const void*> raw_, war_, pending_out_;
+  std::unordered_map<const void*, unsigned long long> producer_;
+  std::unordered_map<const void*, std::string> names_;
+};
+} // namespace
