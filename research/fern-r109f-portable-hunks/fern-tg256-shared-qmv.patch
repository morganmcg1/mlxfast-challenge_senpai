     outputNames: ["activated"],
     source: lagunaSharedSwiGLUQMVRows1Source(halved: true),
@@ -7245,7 +7270,8 @@ private let lagunaSharedSwiGLUQMVRows1HalvedKernel = MLXFast.metalKernel(
 
 
