+            U s1_ = 0;                                             \\
+            s0_ += pair_q0[0] * kk[0];                             \\
+            s1_ += pair_q1[0] * kk[0];                             \\
+            s0_ += pair_q0[1] * kk[1];                             \\
+            s1_ += pair_q1[1] * kk[1];                             \\
+            s0_ += pair_q0[2] * kk[2];                             \\
+            s1_ += pair_q1[2] * kk[2];                             \\
+            s0_ += pair_q0[3] * kk[3];                             \\
+            s1_ += pair_q1[3] * kk[3];                             \\
+            s0_ = simd_sum(s0_);                                   \\
+            s1_ = simd_sum(s1_);                                   \\
+            U m0_ = metal::max(pair_max0, s0_);                    \\
+            U m1_ = metal::max(pair_max1, s1_);                    \\
