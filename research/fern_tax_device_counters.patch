+// ---------------------------------------------------------------------------
+// Research-only dispatch-tax counters (maple-fern PR #268). NEVER SUBMITTED.
+// device.cpp is outside editablePaths; this block exists only so a local
+// worker can report how many dispatches, barriers, and command buffers a
+// decode step actually emitted, and how much of the step the GPU was busy.
+// ---------------------------------------------------------------------------
+namespace {
+std::atomic<uint64_t> dbp_dispatches{0};
+std::atomic<uint64_t> dbp_barriers{0};
+std::atomic<uint64_t> dbp_commits{0};
+std::atomic<uint64_t> dbp_encodings{0};
+std::atomic<uint64_t> dbp_gpu_busy_ns{0};
+std::atomic<uint64_t> dbp_kernel_busy_ns{0};
+std::atomic<uint64_t> dbp_first_start_ns{0};
+std::atomic<uint64_t> dbp_last_end_ns{0};
+
+inline void dbp_note_max(std::atomic<uint64_t>& slot, uint64_t v) {
+  uint64_t cur = slot.load(std::memory_order_relaxed);
+  while (v > cur &&
+         !slot.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {
+  }
+}
+
+inline void dbp_note_min_nonzero(std::atomic<uint64_t>& slot, uint64_t v) {
+  uint64_t cur = slot.load(std::memory_order_relaxed);
+  while ((cur == 0 || v < cur) &&
+         !slot.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {
+  }
+}
+} // namespace
+
+extern "C" void darkbloom_probe_read(uint64_t* out) {
+  uint64_t first = dbp_first_start_ns.exchange(0, std::memory_order_relaxed);
+  uint64_t last = dbp_last_end_ns.exchange(0, std::memory_order_relaxed);
+  out[0] = dbp_dispatches.exchange(0, std::memory_order_relaxed);
+  out[1] = dbp_barriers.exchange(0, std::memory_order_relaxed);
+  out[2] = dbp_commits.exchange(0, std::memory_order_relaxed);
+  out[3] = dbp_gpu_busy_ns.exchange(0, std::memory_order_relaxed);
+  out[4] = dbp_kernel_busy_ns.exchange(0, std::memory_order_relaxed);
+  out[5] = (last > first) ? (last - first) : 0;
+  out[6] = dbp_encodings.exchange(0, std::memory_order_relaxed);
+  out[7] = 0;
+}
+
