+// MARK: - r96-b research instrumentation (reverted before any timing work)
+
+private let r96DumpDir = ProcessInfo.processInfo.environment["DARKBLOOM_R96B_DUMP_DIR"]
+private let r96DumpMaxCalls = 512
+
+/// BF16 -> FP32 is exact, so the FP32 payload below recovers the BF16 bit
+/// pattern as the high 16 bits of each word.
+private func r96F32Data(_ a: MLXArray) -> Data {
+    a.asType(.float32).asArray(Float.self).withUnsafeBufferPointer { Data(buffer: $0) }
+}
+
+func r96DumpRouterDecode(
+    layer: Int, call: inout Int,
+    normalized: MLXArray, logits: MLXArray,
+    routerWeight: MLXArray, correctionBias: MLXArray
+) {
+    guard let dir = r96DumpDir, call < r96DumpMaxCalls else { return }
+    let tag = String(format: "%02d", layer)
+    let actPath = "\(dir)/act_L\(tag).bin"
+    if call == 0 {
+        var w = r96F32Data(routerWeight)
+        w.append(r96F32Data(correctionBias))
+        try? w.write(to: URL(fileURLWithPath: "\(dir)/w_L\(tag).bin"))
+        FileManager.default.createFile(atPath: actPath, contents: nil)
+    }
+    var rec = r96F32Data(normalized)
+    rec.append(r96F32Data(logits))
+    if let fh = FileHandle(forWritingAtPath: actPath) {
+        fh.seekToEndOfFile()
+        fh.write(rec)
+        try? fh.close()
+    }
+    call += 1
+}
+
